{
  "name": "dancing-log-webui",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:webui": "vite build",
    "check:webui": "tsc --noEmit",
    "dev:webui": "vite",
    "test:webui-dev": "playwright test --config playwright.dev.config.ts",
    "test:a11y": "playwright test tests/webui-accessibility",
    "test:a11y:update": "playwright test tests/webui-accessibility --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
